{
    "Print messages to console": {
        "prefix": "pr",
        "body": ["print($1)"]
    },

    "_ready method": {
        "prefix": "_ready",
        "body": ["func _ready() -> void:", "\t${1:pass}"]
    },

    "_init method": {
        "prefix": "_init",
        "body": ["func _init() -> void:", "\t${1:pass}"]
    },

    "_process method": {
        "prefix": "_process",
        "body": ["func _process(_delta: float) -> void:", "\t${1:pass}"]
    },

    "_input method": {
        "prefix": "_input",
        "body": ["func _input(event: InputEvent):", "\t${1:pass}"]
    },

    "for loop": {
        "prefix": "for",
        "body": ["for ${1:var}:${2:Type} in $3:", "\t${4:pass}"]
    },

    "if": {
        "prefix": "ifc",
        "body": ["if ${1:condition}:", "\t${2:pass}"]
    },

    "if else": {
        "prefix": "ife",
        "body": ["if ${1:condition}:", "\t${2:pass}", "else:", "\t${3:pass}"]
    },

    "if elif else": {
        "prefix": "ifee",
        "body": [
            "if ${1:condition}:",
            "\t${3:pass}",
            "elif ${2:condition}:",
            "\t${4:pass}",
            "else:",
            "\t${5:pass}"
        ]
    },

    "while": {
        "prefix": "wh",
        "body": ["while ${1:condition}:", "\t${2:pass}"]
    },

    "function definition": {
        "prefix": "fn",
        "body": ["func ${1:function_name}($2) -> ${3:void}:", "\t${4:pass}"]
    },

    "match": {
        "prefix": "ma",
        "body": [
            "match ${1:expression}:",
            "\t${2:pattern}:",
            "\t\t${3:pass}",
            "\t_:",
            "\t\t${0:pass}"
        ]
    },

    "signal declaration": {
        "prefix": "si",
        "body": ["signal ${1:signal_name}($0)"]
    },

    "export variable": {
        "prefix": "@exv",
        "body": ["@export var ${1:name}: ${2:Type}"]
    },

    "export group": {
        "prefix": "@exg",
        "body": ["@export_group(\"${1:name}\", \"${2:prefix}\")"]
    },

    "export category": {
        "prefix": "@exc",
        "body": ["@export_category(\"${1:name}\")"]
    },

    "export range": {
        "prefix": "@exr",
        "body": [
            "@export_range(${1:min}, ${2:max}, ${3:step}) var ${4:name}: ${5:Type}"
        ]
    },

    "define variable": {
        "prefix": "v",
        "body": ["var ${1:name}: ${2:Type} = $0"]
    },

    "define variable with setter and getter": {
        "prefix": "varsg",
        "body": [
            "var ${1:name}: ${2:Type} = $3:",
            "\tset(${4:new_value}):",
            "\t\t${5:pass}",
            "\tget:",
            "\t\t${0:pass}"
        ]
    },

    "define onready variables": {
        "prefix": "@onr",
        "body": ["@onready var ${1:name}: ${2:Type} = $0"]
    },

    "GDScript basic template": {
        "prefix": "!gd",
        "body": [
            "class_name ${1:ClassName}",
            "extends ${1:Node}",
            "",
            "func _ready() -> void:",
            "\tpass",
            ""
        ]
    },

    "GDScript advanced template": {
        "prefix": "!gda",
        "body": [
            "class_name ${1:ClassName}",
            "extends ${1:Node}",
            "",
            "func _ready() -> void:",
            "\tpass",
            "\n",
            "func build() -> void:",
            "\tpass",
            "\n",
            "func bind_dependencies() -> void:",
            "\tpass",
            "\n",
            "func setup() -> void:",
            "\tpass"
        ]
    }
}
